# Local development only. This is the docker-compose database on port 5433.
# Do NOT copy this line into a deployed service: inside a container localhost
# is that container, not your database. Set DATABASE_URL there to the managed
# instance's connection string (on Railway, reference the Postgres service
# rather than pasting a literal). See DEPLOY.md.
DATABASE_URL=postgresql://mshn:mshn@localhost:5433/mshn

# These three are the same locally and deployed.
FINNHUB_API_KEY=
ANTHROPIC_API_KEY=
EDGAR_USER_AGENT=MSHN/0.1 (you@example.com)
